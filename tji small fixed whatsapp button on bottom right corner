        </svg>
    </a>
</div>

<script>
    (function () {
        var waWrapper = document.getElementById('tjiWaWrapper');
        var footerIds = ['footer-1', 'footer-2', 'footer-3'];

        function waCheckFooter() {
            // Get the exact position of the WhatsApp button
            var buttonRect = waWrapper.getBoundingClientRect();
            var buttonBottom = window.scrollY + buttonRect.bottom;

            var isTouching = false;
            for (var i = 0; i < footerIds.length; i++) {
                var footer = document.getElementById(footerIds[i]);
                if (footer) {
                    var footerTop = footer.getBoundingClientRect().top + window.scrollY;
                    
                    // Only trigger if THIS specific button's bottom touches the footer
                    if (buttonBottom > footerTop) {
                        isTouching = true;
                        break;
                    }
                }
            }
            waWrapper.classList.toggle('on-footer', isTouching);
        }

        // Listen for scroll and window resizing
        window.addEventListener('scroll', waCheckFooter, { passive: true });
        window.addEventListener('resize', waCheckFooter);
        
        // Initial check on page load
        waCheckFooter();
    })();
</script>
