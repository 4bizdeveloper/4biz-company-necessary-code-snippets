<style>
    .tji-whatsapp-wrapper {
        position: fixed;
        bottom: 80px; /* sits above the AI button */
        right: 24px;
        z-index: 999999;
        display: flex;
        align-items: center;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    .tji-wa-btn {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, #1a1f36 0%, #3b4261 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(26, 31, 54, 0.45);
        margin-left: 10px;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        z-index: 10;
        text-decoration: none;
    }
    .tji-wa-icon {
        width: 24px;
        fill: white;
        transition: transform 0.3s ease;
    }
    .tji-wa-label {
        background: white;
        padding: 6px 13px;
        border-radius: 50px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.12);
        font-size: 12px;
        font-weight: 600;
        color: #333;
        opacity: 0;
        transform: translateX(10px);
        transition: all 0.25s ease;
        pointer-events: none;
        white-space: nowrap;
    }
    .tji-whatsapp-wrapper:hover .tji-wa-label {
        opacity: 1;
        transform: translateX(0);
    }
    .tji-whatsapp-wrapper:hover .tji-wa-btn {
        transform: scale(1.08);
        box-shadow: 0 6px 20px rgba(26, 31, 54, 0.5);
    }
    .tji-pulse-ring {
        position: absolute;
        right: 0;
        width: 48px;
        height: 48px;
        background: #1a1f36;
        border-radius: 50%;
        z-index: 5;
        animation: tji-pulse 2.5s infinite;
    }
    @keyframes tji-pulse {
        0% { transform: scale(1); opacity: 0.6; }
        100% { transform: scale(1.9); opacity: 0; }
    }

    /* FOOTER MODE */
    .tji-whatsapp-wrapper.on-footer .tji-wa-btn {
        background: linear-gradient(135deg, #ffffff 0%, #e8e8f0 100%);
        box-shadow: 0 4px 16px rgba(255, 255, 255, 0.35);
    }
    .tji-whatsapp-wrapper.on-footer .tji-pulse-ring { background: #ffffff; }
    .tji-whatsapp-wrapper.on-footer .tji-wa-icon { fill: #1a1f36; }
    .tji-whatsapp-wrapper.on-footer .tji-wa-label {
        background: #1a1f36;
        color: #ffffff;
    }

    @media (max-width: 768px) {
        .tji-wa-label { display: none; }
        .tji-whatsapp-wrapper { bottom: 70px; right: 16px; }
        .tji-wa-btn, .tji-pulse-ring { width: 44px; height: 44px; }
        .tji-wa-icon { width: 22px; }
    }
    @media (max-width: 480px) {
        .tji-whatsapp-wrapper { bottom: 65px; right: 12px; }
        .tji-wa-btn, .tji-pulse-ring { width: 42px; height: 42px; }
        .tji-wa-icon { width: 20px; }
    }
</style>

<div class="tji-whatsapp-wrapper" id="tjiWaWrapper">
    <div class="tji-wa-label">WhatsApp</div>
    <div class="tji-pulse-ring"></div>
    <a href="https://wa.me/+971505248584?text=Hello! I'd like to inquire about your services." target="_blank" class="tji-wa-btn">
        <svg viewBox="0 0 32 32" class="tji-wa-icon">
