<script>
    /* ── Scroll watcher for WhatsApp footer color swap ── */
    (function () {
        var waWrapper = document.getElementById('tjiWaWrapper');
        var footerIds = ['footer-1', 'footer-2', 'footer-3'];

        function isInFooter() {
            var scrollBottom = window.scrollY + window.innerHeight;
            for (var i = 0; i < footerIds.length; i++) {
                var el = document.getElementById(footerIds[i]);
                if (el) {
                    var rect = el.getBoundingClientRect();
                    var elTop = rect.top + window.scrollY;
                    var elBottom = elTop + el.offsetHeight;
                    if (scrollBottom > elTop && window.scrollY < elBottom) {
                        return true;
                    }
                }
            }
            return false;
        }

        function onScroll() {
            if (isInFooter()) {
                waWrapper.classList.add('on-footer');
            } else {
                waWrapper.classList.remove('on-footer');
            }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
    })();
</script>
