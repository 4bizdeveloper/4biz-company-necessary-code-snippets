<style>
    .tji-whatsapp-wrapper {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 999999;
        display: flex;
        align-items: center;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    .tji-wa-btn {
        width: 65px;
        height: 65px;
        background: linear-gradient(135deg, #1a1f36 0%, #3b4261 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 25px rgba(26, 31, 54, 0.4);
        margin-left: 15px;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        z-index: 10;
        text-decoration: none;
    }
    .tji-wa-icon {
        width: 35px;
        fill: white;
        transition: transform 0.3s ease;
    }
    .tji-wa-label {
        background: white;
        padding: 8px 16px;
        border-radius: 50px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin-right: 15px;
        font-weight: 600;
        color: #333;
        opacity: 0;
        transform: translateX(20px);
        transition: all 0.3s ease;
        pointer-events: none;
    }
    .tji-whatsapp-wrapper:hover .tji-wa-label {
        opacity: 1;
        transform: translateX(0);
    }
    .tji-whatsapp-wrapper:hover .tji-wa-btn {
        transform: scale(1.1) rotate(5deg);
        box-shadow: 0 10px 25px rgba(26, 31, 54, 0.4);
    }
    .tji-pulse-ring {
        position: absolute;
        right: 0;
        width: 65px;
        height: 65px;
        background: #1a1f36;
        border-radius: 50%;
        z-index: 5;
        animation: tji-pulse 2s infinite;
    }
    @keyframes tji-pulse {
        0% { transform: scale(1); opacity: 0.7; }
        100% { transform: scale(1.8); opacity: 0; }
    }

    /* ── FOOTER MODE (swapped colors) ── */
    .tji-whatsapp-wrapper.on-footer .tji-wa-btn {
        background: linear-gradient(135deg, #ffffff 0%, #e8e8f0 100%);
        box-shadow: 0 10px 25px rgba(255, 255, 255, 0.4);
    }
    .tji-whatsapp-wrapper.on-footer .tji-pulse-ring {
        background: #ffffff;
    }
    .tji-whatsapp-wrapper.on-footer .tji-wa-icon {
        fill: #1a1f36;
    }
    .tji-whatsapp-wrapper.on-footer .tji-wa-label {
        background: #1a1f36;
        color: #ffffff;
        box-shadow: 0 4px 15px rgba(26, 31, 54, 0.3);
    }
    .tji-whatsapp-wrapper.on-footer:hover .tji-wa-btn {
        box-shadow: 0 10px 25px rgba(255, 255, 255, 0.5);
    }

    /* ── matches AI button breakpoints exactly ── */
    @media (max-width: 768px) {
        .tji-wa-label { display: none; }
        .tji-whatsapp-wrapper { bottom: 20px; right: 20px; }
        .tji-wa-btn { width: 55px; height: 55px; }
        .tji-pulse-ring { width: 55px; height: 55px; }
        .tji-wa-icon { width: 30px; }
    }

    @media (max-width: 480px) {
        .tji-whatsapp-wrapper { bottom: 16px; right: 14px; }
        .tji-wa-btn { width: 50px; height: 50px; }
        .tji-pulse-ring { width: 50px; height: 50px; }
        .tji-wa-icon { width: 27px; }
    }
</style>

<div class="tji-whatsapp-wrapper" id="tjiWaWrapper">
