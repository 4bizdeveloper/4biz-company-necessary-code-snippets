<style>
    #formilla-chat-button-inner, .formilla-chat-launcher { display: none !important; }

    /* ══════════════════════════════════════════
       FLOATING BUTTON — preserved from original
    ══════════════════════════════════════════ */
    .tji-ai-wrapper {
        position: fixed; bottom: 30px; left: 30px; z-index: 999999;
        display: flex; align-items: center; font-family: 'Segoe UI', Roboto, sans-serif;
        transition: all 0.3s ease;
    }
    .tji-ai-btn {
        width: 65px; height: 65px; border-radius: 50%;
        background: linear-gradient(135deg, #1a1f36 0%, #3b4261 100%);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 10px 25px rgba(26, 31, 54, 0.4);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        cursor: pointer; position: relative; z-index: 10;
    }
    .tji-ai-icon { width: 45px; transition: transform 0.3s ease; }
    .tji-ai-icon .ic-fg  { fill: #ffffff; }
    .tji-ai-icon .ic-bg  { fill: #1a1f36; }
    .tji-ai-icon .ic-sfg { stroke: #ffffff; fill: none; }
    .tji-ai-icon .ic-sbg { stroke: #1a1f36; fill: none; }
    .tji-ai-icon .ic-lfg { stroke: #ffffff; fill: none; }
    .tji-ai-icon .ic-lbg { stroke: #1a1f36; fill: none; }
    .tji-ai-label {
        background: white; padding: 8px 16px; border-radius: 50px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1); margin-left: 15px;
        font-weight: 600; color: #333; opacity: 0;
        transform: translateX(-20px); transition: all 0.3s ease;
        pointer-events: none; white-space: nowrap;
    }
    .tji-ai-wrapper:hover .tji-ai-label { opacity: 1; transform: translateX(0); }
    .tji-ai-wrapper:hover .tji-ai-btn { transform: scale(1.1) rotate(-5deg); }
    .tji-ai-pulse-ring {
        position: absolute; left: 0; width: 65px; height: 65px;
        background: #1a1f36; border-radius: 50%; z-index: 5;
        animation: tji-ai-pulse 2s infinite;
    }
    @keyframes tji-ai-pulse {
        0%  { transform: scale(1);   opacity: 0.7; }
        100%{ transform: scale(1.8); opacity: 0;   }
    }
    .tji-ai-wrapper.on-footer .tji-ai-btn {
        background: linear-gradient(135deg, #ffffff 0%, #ededff 100%);
        box-shadow: 0 10px 25px rgba(255, 255, 255, 0.4);
    }
    .tji-ai-wrapper.on-footer .tji-ai-pulse-ring { background: #ffffff; }
    .tji-ai-wrapper.on-footer .tji-ai-label { background: #1a1f36; color: #ffffff; box-shadow: 0 4px 15px rgba(26, 31, 54, 0.3); }
    .tji-ai-wrapper.on-footer .tji-ai-icon .ic-fg  { fill: #1a1f36; }
    .tji-ai-wrapper.on-footer .tji-ai-icon .ic-bg  { fill: #ffffff; }
    .tji-ai-wrapper.on-footer .tji-ai-icon .ic-sfg { stroke: #1a1f36; fill: none; }
    .tji-ai-wrapper.on-footer .tji-ai-icon .ic-sbg { stroke: #ffffff; fill: none; }
    .tji-ai-wrapper.on-footer .tji-ai-icon .ic-lfg { stroke: #1a1f36; fill: none; }
    .tji-ai-wrapper.on-footer .tji-ai-icon .ic-lbg { stroke: #ffffff; fill: none; }
    @media (max-width: 768px) {
        .tji-ai-label { display: none; }
        .tji-ai-wrapper { bottom: 20px; left: 20px; }
        .tji-ai-btn, .tji-ai-pulse-ring { width: 55px; height: 55px; }
    }

    /* ══════════════════════════════════════════
       GEMINI CHAT WINDOW — ultra modern 3D style
    ══════════════════════════════════════════ */
    @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Exo+2:wght@300;400;500;600&display=swap');

    #tji-chat-overlay {
        display: none; position: fixed; inset: 0; z-index: 9999998;
        background: rgba(5,8,20,0.6); backdrop-filter: blur(4px);
        animation: tji-fadeIn 0.3s ease;
    }
    #tji-chat-overlay.open { display: block; }

    @keyframes tji-fadeIn { from { opacity:0 } to { opacity:1 } }
    @keyframes tji-slideUp { from { opacity:0; transform:translateY(40px) scale(0.95) } to { opacity:1; transform:translateY(0) scale(1) } }
    @keyframes tji-msgIn  { from { opacity:0; transform:translateY(10px) } to { opacity:1; transform:translateY(0) } }
    @keyframes tji-spin   { to { transform: rotate(360deg) } }
    @keyframes tji-gridPulse { 0%,100%{opacity:.04} 50%{opacity:.08} }
    @keyframes tji-scanline { 0%{transform:translateY(-100%)} 100%{transform:translateY(400%)} }

    #tji-chat-window {
        position: fixed;
        bottom: 110px; left: 30px;
        width: 480px;
        /* Height: fill from bottom anchor up to 20px from top of viewport */
        max-height: calc(100vh - 130px);
        height: 650px;
        background: linear-gradient(160deg, #1a1f36 0%, #141829 50%, #0d1020 100%);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 24px;
        box-shadow:
            0 0 0 1px rgba(59,66,97,0.4),
            0 40px 100px rgba(0,0,0,0.8),
            0 0 60px rgba(26,31,54,0.4),
            inset 0 1px 0 rgba(255,255,255,0.1);
        display: flex; flex-direction: column;
        overflow: hidden;
        font-family: 'Exo 2', sans-serif;
        animation: tji-slideUp 0.4s cubic-bezier(0.16,1,0.3,1);
        z-index: 9999999;
    }

    /* Blueprint grid bg */
    #tji-chat-window::before {
        content:''; position:absolute; inset:0; z-index:0;
        background-image:
            linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
        background-size: 30px 30px;
        animation: tji-gridPulse 4s ease-in-out infinite;
        pointer-events:none;
    }
    /* Scanline effect */
    #tji-chat-window::after {
        content:''; position:absolute; left:0; right:0; top:0;
        height:80px; z-index:1;
        background: linear-gradient(transparent, rgba(255,255,255,0.03), transparent);
        animation: tji-scanline 6s linear infinite;
        pointer-events:none;
    }

    /* HEADER */
    #tji-chat-header {
        position:relative; z-index:10;
        padding: 20px 22px 16px;
        background: linear-gradient(135deg, rgba(59,66,97,0.9) 0%, rgba(26,31,54,0.98) 55%, rgba(13,16,32,1) 100%);
        border-bottom: 1px solid rgba(255,255,255,0.1);
        flex-shrink:0;
    }
    #tji-chat-header-top {
        display:flex; align-items:center; justify-content:space-between;
    }
    #tji-chat-brand {
        display:flex; align-items:center; gap:12px;
    }
    #tji-chat-avatar {
        width:44px; height:44px; border-radius:12px;
        background: linear-gradient(135deg, #3b4261, #5a6285, #3b4261);
        display:flex; align-items:center; justify-content:center;
        box-shadow: 0 4px 15px rgba(26,31,54,0.6);
        position:relative; overflow:hidden;
        border: 1px solid rgba(255,255,255,0.15);
    }
    #tji-chat-avatar::after {
        content:''; position:absolute; inset:0;
        background: linear-gradient(135deg, rgba(255,255,255,0.18), transparent);
    }
    #tji-chat-title { font-family:'Rajdhani',sans-serif; }
    #tji-chat-title h3 {
        margin:0; font-size:17px; font-weight:700;
        color:#fff; letter-spacing:2px; line-height:1;
        text-transform: uppercase;
    }
    #tji-chat-title p {
        margin:3px 0 0; font-size:11px; color:rgba(255,255,255,0.55);
        letter-spacing:2px; text-transform:uppercase;
    }
    #tji-close-btn {
        width:32px; height:32px; border-radius:8px; border:none;
        background:rgba(255,255,255,0.08); color:rgba(255,255,255,0.6);
        cursor:pointer; display:flex; align-items:center; justify-content:center;
        font-size:18px; transition:all 0.2s; flex-shrink:0;
    }
    #tji-close-btn:hover { background:rgba(255,255,255,0.18); color:#fff; }

    #tji-status-bar {
        margin-top:10px; display:flex; align-items:center; gap:8px;
    }
    .tji-status-dot {
        width:7px; height:7px; border-radius:50%; background:#4ade80;
        box-shadow: 0 0 8px rgba(74,222,128,0.8);
        animation: tji-ai-pulse 2s infinite;
    }
    .tji-status-text { font-size:11px; color:rgba(255,255,255,0.5); letter-spacing:1px; }
    .tji-status-badge {
        margin-left:auto; font-size:9px; letter-spacing:2px; text-transform:uppercase;
        color:rgba(255,255,255,0.75); background:rgba(255,255,255,0.1);
        border:1px solid rgba(255,255,255,0.18); border-radius:4px; padding:2px 7px;
        font-family:'Rajdhani',sans-serif; font-weight:600;
    }

    /* MESSAGES */
    #tji-messages {
        flex:1; overflow-y:auto; padding:16px;
        position:relative; z-index:5;
        scroll-behavior: smooth;
    }
    #tji-messages::-webkit-scrollbar { width:4px; }
    #tji-messages::-webkit-scrollbar-track { background:transparent; }
    #tji-messages::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.15); border-radius:2px; }

    .tji-msg {
        display:flex; gap:10px; margin-bottom:16px;
        animation: tji-msgIn 0.3s ease;
    }
    .tji-msg.user { flex-direction:row-reverse; }

    .tji-msg-avatar {
        width:32px; height:32px; border-radius:9px; flex-shrink:0;
        display:flex; align-items:center; justify-content:center;
        font-size:14px; font-weight:700; align-self:flex-end;
    }
    .tji-msg.bot .tji-msg-avatar {
        background:linear-gradient(135deg,#3b4261,#5a6285);
        border:1px solid rgba(255,255,255,0.15);
        color:#fff; font-family:'Rajdhani',sans-serif;
    }
    .tji-msg.user .tji-msg-avatar {
        background:rgba(255,255,255,0.1);
        border:1px solid rgba(255,255,255,0.15); color:rgba(255,255,255,0.7);
    }

    .tji-msg-bubble {
        max-width:80%; padding:12px 16px; border-radius:16px;
        font-size:13.5px; line-height:1.65; position:relative;
    }
    .tji-msg.bot .tji-msg-bubble {
        background:rgba(255,255,255,0.07);
        border:1px solid rgba(255,255,255,0.12);
        color:#ffffff;
        border-bottom-left-radius:4px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.3);
    }
    .tji-msg.user .tji-msg-bubble {
        background:linear-gradient(135deg,rgba(59,66,97,0.9),rgba(26,31,54,0.8));
        border:1px solid rgba(255,255,255,0.18);
        color:#ffffff;
        border-bottom-right-radius:4px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.3);
    }
    .tji-msg-time {
        font-size:10px; color:rgba(255,255,255,0.3);
        margin-top:4px; display:block;
        font-family:'Rajdhani',sans-serif; letter-spacing:1px;
    }
    .tji-msg.user .tji-msg-time { text-align:right; }

    /* Typing indicator */
    #tji-typing {
        display:none; align-items:center; gap:10px;
        padding:0 16px 12px; position:relative; z-index:5;
    }
    #tji-typing.visible { display:flex; }
    .tji-typing-dots {
        display:flex; gap:5px; background:rgba(255,255,255,0.06);
        border:1px solid rgba(255,255,255,0.12);
        padding:10px 14px; border-radius:14px; border-bottom-left-radius:4px;
    }
    .tji-typing-dots span {
        width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,0.5);
        animation: tji-bounce 1.2s infinite;
    }
    .tji-typing-dots span:nth-child(2) { animation-delay:.2s; }
    .tji-typing-dots span:nth-child(3) { animation-delay:.4s; }
    @keyframes tji-bounce {
        0%,60%,100% { transform:translateY(0) }
        30% { transform:translateY(-6px) }
    }

    /* QUICK SUGGESTIONS */
    #tji-suggestions {
        position:relative; z-index:5;
        padding:0 16px 12px;
        display:flex; gap:7px; flex-wrap:wrap;
    }
    .tji-suggestion-chip {
        font-size:11.5px; padding:6px 13px; border-radius:20px; cursor:pointer;
        border:1px solid rgba(255,255,255,0.2); color:rgba(255,255,255,0.8);
        background:rgba(255,255,255,0.07);
        transition:all 0.2s ease;
        font-family:'Rajdhani',sans-serif; letter-spacing:0.8px; white-space:nowrap;
        font-weight:600;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.06);
    }
    .tji-suggestion-chip:hover {
        background:rgba(255,255,255,0.16); border-color:rgba(255,255,255,0.4);
        color:#fff; transform:translateY(-1px);
        box-shadow: 0 4px 14px rgba(26,31,54,0.5);
    }

    /* INPUT AREA */
    #tji-chat-input-area {
        position:relative; z-index:10;
        padding:14px 18px 18px;
        border-top:1px solid rgba(255,255,255,0.1);
        background: linear-gradient(180deg, rgba(26,31,54,0.6) 0%, rgba(13,16,32,0.98) 100%);
        flex-shrink:0;
        backdrop-filter: blur(10px);
    }
    #tji-input-row {
        display:flex; gap:10px; align-items:flex-end;
    }
    #tji-input {
        flex:1; background:rgba(255,255,255,0.07);
        border:1px solid rgba(255,255,255,0.15); border-radius:14px;
        padding:12px 16px; color:#fff; font-size:13.5px;
        font-family:'Exo 2',sans-serif; resize:none; min-height:46px; max-height:120px;
        outline:none; transition:all 0.25s;
        scrollbar-width:thin; line-height:1.5;
        box-shadow: inset 0 2px 8px rgba(0,0,0,0.3);
    }
    #tji-input::placeholder { color:rgba(255,255,255,0.28); }
    #tji-input:focus {
        border-color:rgba(255,255,255,0.35);
        background:rgba(255,255,255,0.1);
        box-shadow: inset 0 2px 8px rgba(0,0,0,0.3), 0 0 0 3px rgba(255,255,255,0.06);
    }

    #tji-send-btn {
        width:50px; height:50px; border-radius:14px; border:none; cursor:pointer;
        background:linear-gradient(135deg, #3b4261, #5a6285);
        display:flex; align-items:center; justify-content:center;
        transition:all 0.2s; flex-shrink:0;
        box-shadow: 0 4px 18px rgba(26,31,54,0.6);
        border: 1px solid rgba(255,255,255,0.18);
        padding:0;
    }
    #tji-send-btn:hover { transform:scale(1.06); box-shadow:0 6px 24px rgba(26,31,54,0.8); background:linear-gradient(135deg, #4a5275, #6a73a0); }
    #tji-send-btn:active { transform:scale(0.97); }
    #tji-send-btn svg { width:24px; height:24px; fill:#ffffff; display:block; }
    #tji-send-btn.loading {
        background:rgba(255,255,255,0.1);
        pointer-events:none;
    }
    #tji-send-btn.loading svg { animation:tji-spin 1s linear infinite; }

    #tji-input-footer {
        margin-top:9px; text-align:center; font-size:10px;
        color:rgba(255,255,255,0.22); letter-spacing:2px;
        text-transform:uppercase; font-family:'Rajdhani',sans-serif;
    }

    /* Corner accents */
    .tji-corner {
        position:absolute; width:16px; height:16px;
        border-color:rgba(255,255,255,0.25); border-style:solid; z-index:15;
    }
    .tji-corner.tl { top:8px; left:8px; border-width:2px 0 0 2px; border-radius:2px 0 0 0; }
    .tji-corner.tr { top:8px; right:8px; border-width:2px 2px 0 0; border-radius:0 2px 0 0; }
    .tji-corner.bl { bottom:8px; left:8px; border-width:0 0 2px 2px; border-radius:0 0 0 2px; }
    .tji-corner.br { bottom:8px; right:8px; border-width:0 2px 2px 0; border-radius:0 0 2px 0; }

    /* ── TABLET (481–768px) ── */
    @media (max-width: 768px) and (min-width: 481px) {
        #tji-chat-window {
            left: 15px; right: 15px;
            top: 12px; bottom: 95px;
            width: auto; height: auto;
            max-height: none;
        }
    }

    /* ── MOBILE (≤480px) — pinned top+bottom, truly fixed inside screen ── */
    @media (max-width: 480px) {
        /* Floating button */
        .tji-ai-wrapper { bottom: 16px; left: 14px; }
        .tji-ai-btn, .tji-ai-pulse-ring { width: 50px; height: 50px; }
        .tji-ai-icon { width: 36px; }

        /* Chat window: pin ALL four sides — guaranteed inside viewport */
        #tji-chat-window {
            position: fixed !important;
            top: 10px !important;
            left: 8px !important;
            right: 8px !important;
            bottom: 78px !important;
            width: auto !important;
            height: auto !important;
            max-height: none !important;
            min-height: 0 !important;
            border-radius: 18px;
        }

        /* Tighter header */
        #tji-chat-header { padding: 12px 14px 10px; }
        #tji-chat-avatar { width: 34px; height: 34px; border-radius: 9px; }
        #tji-chat-avatar svg { width: 20px; height: 20px; }
        #tji-chat-title h3 { font-size: 13px; letter-spacing: 1.5px; }
        #tji-chat-title p  { font-size: 9px; letter-spacing: 1.2px; }
        #tji-close-btn { width: 28px; height: 28px; font-size: 15px; }
        #tji-status-bar { margin-top: 6px; }
        .tji-status-text { font-size: 10px; }
        .tji-status-badge { font-size: 8px; padding: 2px 5px; }

        /* Messages */
        #tji-messages { padding: 10px 12px; }
        .tji-msg { margin-bottom: 10px; gap: 7px; }
        .tji-msg-avatar { width: 26px; height: 26px; border-radius: 7px; }
        .tji-msg-avatar svg { width: 14px !important; height: 14px !important; }
        .tji-msg-bubble { font-size: 12.5px; padding: 9px 11px; border-radius: 12px; max-width: 86%; }
        .tji-msg-time { font-size: 9px; }

        /* Typing */
        #tji-typing { padding: 0 12px 8px; }
        .tji-typing-dots { padding: 7px 11px; }

        /* Suggestions — horizontal scroll, no wrap */
        #tji-suggestions {
            padding: 0 12px 8px;
            flex-wrap: nowrap;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            gap: 6px;
            scrollbar-width: none;
        }
        #tji-suggestions::-webkit-scrollbar { display: none; }
        .tji-suggestion-chip { font-size: 10.5px; padding: 5px 10px; flex-shrink: 0; }

        /* Input area */
        #tji-chat-input-area { padding: 9px 12px 12px; }
        #tji-input { font-size: 13px; padding: 9px 12px; min-height: 38px; border-radius: 11px; }
        #tji-send-btn { width: 40px; height: 40px; border-radius: 11px; }
        #tji-send-btn svg { width: 19px !important; height: 19px !important; }
        #tji-input-footer { font-size: 8.5px; margin-top: 5px; letter-spacing: 1.2px; }

        /* Corner accents */
        .tji-corner { width: 11px; height: 11px; }
    }
</style>

