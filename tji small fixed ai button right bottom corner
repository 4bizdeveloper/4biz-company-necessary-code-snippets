ntence\n- Keep responses clear and helpful (aim for 80-160 words)\n- Reinforce TJI brand pillars: precision, craftsmanship, innovation, bespoke quality, UAE expertise\n- Direct gallery questions to: https://tjimodelmaking.com/gallery/\n- Direct services questions to: https://tjimodelmaking.com/services/";

    var history  = [];
    var isTyping = false;

    window.tjiOpenChat = function () {
        document.getElementById('tji-chat-overlay').classList.add('open');
        document.getElementById('tji-chat-window').style.display = 'flex';
        if (history.length === 0) tjiWelcome();
        setTimeout(function(){ document.getElementById('tji-input').focus(); }, 100);
    };

    window.tjiCloseChat = function () {
        document.getElementById('tji-chat-overlay').classList.remove('open');
        document.getElementById('tji-chat-window').style.display = 'none';
    };

    function tjiWelcome() {
        tjiAddMsg('bot', '👋 Welcome to <strong>TJI Model Making LLC</strong> — Dubai\'s premier scale model makers since 2007.<br><br>Ask me about our architectural, interior, marine, industrial, masterplan or sculpture models — or how we can bring your vision to life!');
    }

    function tjiAddMsg(role, html) {
        var msgs   = document.getElementById('tji-messages');
        var now    = new Date();
        var timeStr = now.getHours().toString().padStart(2,'0') + ':' + now.getMinutes().toString().padStart(2,'0');
        var avatarContent = role === 'bot'
            ? '<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" style="width:16px;height:16px;"><circle cx="28" cy="32" r="4.5" fill="#fff"/><line x1="28" x2="42" y1="32" y2="48" stroke="#fff" stroke-width="3" stroke-linecap="round"/><path d="M50 42c-15 0-27 12-27 27s12 27 27 27 27-12 27-27-12-27-27-27z" fill="#fff"/><path d="M32 65c0-4 3-8 8-8h20c5 0 8 4 8 8v5c0 4-3 8-8 8H40c-5 0-8-4-8-8v-5z" fill="#3b4261"/></svg>'
            : '👤';
        var div = document.createElement('div');
        div.className = 'tji-msg ' + role;
        div.innerHTML =
            '<div class="tji-msg-avatar">' + avatarContent + '</div>' +
            '<div><div class="tji-msg-bubble">' + html + '</div><span class="tji-msg-time">' + timeStr + '</span></div>';
        msgs.appendChild(div);
        msgs.scrollTop = msgs.scrollHeight;
    }

    window.tjiSend = function () {
        var input = document.getElementById('tji-input');
        var text  = input.value.trim();
        if (!text || isTyping) return;
        input.value = '';
        input.style.height = 'auto';
        tjiDispatch(text);
    };

    window.tjiSendSuggestion = function (el) {
        var text = el.textContent.trim();
        document.getElementById('tji-suggestions').style.display = 'none';
        tjiDispatch(text);
    };

    function tjiDispatch(text) {
        tjiAddMsg('user', tjiEscape(text));
        history.push({ role: 'user', parts: [{ text: text }] });
        tjiSetTyping(true);
        tjiCallAPI();
    }

    function tjiSetTyping(on) {
        isTyping = on;
        var el  = document.getElementById('tji-typing');
        var btn = document.getElementById('tji-send-btn');
        el.className = on ? 'visible' : '';
        btn.className = on ? 'loading' : '';
        btn.innerHTML = on
            ? '<svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="fill:none;stroke:#fff;stroke-width:2.5;stroke-linecap:round;display:block"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>'
            : '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>';
        document.getElementById('tji-messages').scrollTop = 99999;
    }

    /* Gemini API call */
    function tjiCallAPI() {
        var payload = {
            system_instruction: {
                parts: [{ text: SYSTEM_PROMPT }]
            },
            contents: history,
            generationConfig: {
                maxOutputTokens: 1024,
                temperature: 0.7,
                stopSequences: []
            }
        };

        fetch(GEMINI_API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            tjiSetTyping(false);
            var text = '';
            try {
                if (data.error) throw new Error(data.error.message || 'API error');
                var candidate = data.candidates && data.candidates[0];
                if (!candidate) throw new Error('no candidate');
                text = candidate.content.parts.map(function(p){ return p.text || ''; }).join('');
                if (!text.trim()) throw new Error('empty response');
            } catch(e) {
                console.error('TJI AI error:', e, data);
                text = "Sorry, I couldn't process that right now. Please reach us directly:\n\u{1F4DE} +971 50 524 8584\n\u2709\uFE0F info@tjimodelmaking.com";
            }
            history.push({ role: 'model', parts: [{ text: text }] });
            tjiAddMsg('bot', tjiMarkdown(text));
        })
        .catch(function(err) {
            tjiSetTyping(false);
            console.error('TJI AI fetch error:', err);
            tjiAddMsg('bot', "\u26A0\uFE0F Connection issue. Please reach us directly:<br><br>"
                + "<a href='tel:+971505248584' style='color:#fff;font-weight:600;display:block;margin-bottom:4px;text-decoration:none'>\u{1F4DE} +971 50 524 8584</a>"
                + "<a href='mailto:info@tjimodelmaking.com' style='color:#fff;font-weight:600;display:block;text-decoration:none'>\u2709\uFE0F info@tjimodelmaking.com</a>");
        });
    }

    function tjiEscape(s) {
        return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
    function tjiMarkdown(t) {
        return t
            .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>')
            .replace(/\*(.*?)\*/g,'<em>$1</em>')
            .replace(/\n/g,'<br>');
    }

    document.getElementById('tji-input').addEventListener('input', function () {
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 100) + 'px';
    });
    document.getElementById('tji-input').addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); tjiSend(); }
    });

/* AI Button: Footer color swap */
    var aiWrapper = document.getElementById('tjiAiWrapper');
    var footerIds = ['footer-1', 'footer-2', 'footer-3'];

    function tjiCheckFooter() {
        // Get the exact position of the AI button
        var buttonRect = aiWrapper.getBoundingClientRect();
        var buttonBottom = window.scrollY + buttonRect.bottom;
        
        var isTouching = false;
        for (var i = 0; i < footerIds.length; i++) {
            var footer = document.getElementById(footerIds[i]);
            if (footer) {
                var footerTop = footer.getBoundingClientRect().top + window.scrollY;
                // Only change if THIS button's bottom edge enters the footer
                if (buttonBottom > footerTop) {
                    isTouching = true;
                    break;
                }
            }
        }
        aiWrapper.classList.toggle('on-footer', isTouching);
    }

    window.addEventListener('scroll', tjiCheckFooter, { passive: true });
    window.addEventListener('resize', tjiCheckFooter); 
    tjiCheckFooter();
})();
</script>
